# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_ANALYSIS_MODEL=gpt-6-astra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SAFETY_HMAC_SECRET=replace_with_random_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_secret_key

# Security / limits
ALLOW_DEMO=false
MAX_RESUME_BYTES=12000000
MAX_JD_CHARS=30000
MAX_TRANSCRIPT_MESSAGES=600
RETENTION_DAYS=30
CRON_SECRET=replace_with_cron_secret

# Optional distributed rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Zapier webhook
ZAPIER_WEBHOOK_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
